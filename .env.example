# Required
DATABASE_URL=postgres://garden_user:garden_pass@localhost:5432/garden_db
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=*

# JWT Secrets (use strong random values in production: openssl rand -hex 32)
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-32chars

# OpenTelemetry (optional — traces are only exported when this is set)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
